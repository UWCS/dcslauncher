{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dcslauncher",
  "version": "0.1.0",
  "identifier": "uk.co.uwcs.dcslauncher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "dcslauncher",
        "width": 800,
        "height": 600
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
